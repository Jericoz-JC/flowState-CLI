# Binaries
*.exe
*.exe~
*.dll
*.so
*.dylib

# Local build output of the flowstate binary (build into ./dist instead).
# The extensionless name means *.exe rules above do not catch it, so it must
# be listed explicitly to avoid committing a stale binary to the repo root.
/flowstate
/flowstate-*
/cmd/flowState/flowState
/cmd/flowState/flowstate

# Test binary
*.test

# Output of go coverage
*.out

# Logs
*.log
debug.log

# Go workspace
go.work
go.work.sum

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Database
*.db
*.db-journal

# ML Models (embedding models, not Go code)
/models/
!/models/README.md

# Config
config.yaml

# Environment variables (NEVER commit tokens/secrets)
.env
.env.*
*.env

# GoReleaser build output
dist/
.claude/
